{
  "name": "rvm-viewer-frontend",
  "private": true,
  "version": "0.2.0",
  "description": "RVM Viewer — AIDT 平台模型查看器前端（React + three.js，纯静态部署）",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.12.1 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{src,test}/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\"",
    "check": "tsc --noEmit",
    "type-coverage": "type-coverage --at-least 100 --strict -p tsconfig.type-coverage.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm type-coverage && pnpm test && pnpm build",
    "prepare:aidt": "node ../scripts/prepare-aidt-release.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jiti": "^2.4.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "type-coverage": "^2.29.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
